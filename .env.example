# The audit itself needs no AI. These only power the plain-language verdict
# and the ranked fix list; without any key the deterministic report still
# renders in full.

# Preferred provider. Cheapest per token and new models land here first.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# Optional fallback, used only when OpenRouter fails or is unset.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
